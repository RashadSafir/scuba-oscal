  "catalog": {
    "uuid": "e672117a-2e13-5b6a-8993-afca63822e08",
    "metadata": {
      "title": "CISA SCuBA Microsoft Entra ID (MS.AAD) Baseline",
      "last-modified": "2026-09-23T00:00:00+00:00",
      "version": "0.2.0",
      "oscal-version": "1.1.2"
    },
    "groups": [
      {
        "id": "ms.aad.1",
        "title": "Legacy Authentication",
        "controls": [
          {
            "id": "ms.aad.1.1v1",
            "title": "Block legacy authentication",
            "props": [
              {
                "name": "obligation",
                "ns": "https://scuba.example/ns",
                "value": "SHALL"
              },
              {
                "name": "label",
                "value": "MS.AAD.1.1v1"
              }
            ],
            "links": [
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#cm-7",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 CM-7"
              }
            ],
            "parts": [
              {
                "id": "ms.aad.1.1v1_smt",
                "name": "statement",
                "prose": "Legacy authentication SHALL be blocked."
              },
              {
                "id": "ms.aad.1.1v1_gdn",
                "name": "guidance",
                "prose": "The security risk of allowing legacy authentication protocols is they do not support MFA. Blocking legacy protocols reduces the impact of user credential theft."
              }
            ]
          }
        ]
      },
      {
        "id": "ms.aad.2",
        "title": "Risk Based Policies",
        "controls": [
          {
            "id": "ms.aad.2.1v1",
            "title": "Block high-risk users",
            "props": [
              {
                "name": "obligation",
                "ns": "https://scuba.example/ns",
                "value": "SHALL"
              },
              {
                "name": "label",
                "value": "MS.AAD.2.1v1"
              }
            ],
            "links": [
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ac-2.12",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 AC-2(12)"
              },
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ac-2.13",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 AC-2(13)"
              }
            ],
            "parts": [
              {
                "id": "ms.aad.2.1v1_smt",
                "name": "statement",
                "prose": "Users detected as high risk SHALL be blocked."
              },
              {
                "id": "ms.aad.2.1v1_gdn",
                "name": "guidance",
                "prose": "Blocking high-risk users may prevent compromised accounts from accessing the tenant."
              }
            ]
          },
          {
            "id": "ms.aad.2.3v1",
            "title": "Block high-risk sign-ins",
            "props": [
              {
                "name": "obligation",
                "ns": "https://scuba.example/ns",
                "value": "SHALL"
              },
              {
                "name": "label",
                "value": "MS.AAD.2.3v1"
              }
            ],
            "links": [
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ac-2.12",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 AC-2(12)"
              },
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ac-2.13",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 AC-2(13)"
              }
            ],
            "parts": [
              {
                "id": "ms.aad.2.3v1_smt",
                "name": "statement",
                "prose": "Sign-ins detected as high risk SHALL be blocked."
              },
              {
                "id": "ms.aad.2.3v1_gdn",
                "name": "guidance",
                "prose": "This prevents compromised accounts from accessing the tenant."
              }
            ]
          }
        ]
      },
      {
        "id": "ms.aad.3",
        "title": "Strong Authentication and a Secure Registration Process",
        "controls": [
          {
            "id": "ms.aad.3.8v1",
            "title": "Require managed devices to register MFA",
            "props": [
              {
                "name": "obligation",
                "ns": "https://scuba.example/ns",
                "value": "SHOULD"
              },
              {
                "name": "label",
                "value": "MS.AAD.3.8v1"
              }
            ],
            "links": [
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ac-20",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 AC-20b"
              },
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ia-3",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 IA-3"
              }
            ],
            "parts": [
              {
                "id": "ms.aad.3.8v1_smt",
                "name": "statement",
                "prose": "Managed Devices SHOULD be required to register MFA."
              },
              {
                "id": "ms.aad.3.8v1_gdn",
                "name": "guidance",
                "prose": "Reduce risk of an adversary using stolen user credentials and then registering their own MFA device to access the tenant by requiring a managed device provisioned and controlled by the agency to perform registration actions. This prevents the adversary from using their own unmanaged device to perform the registration."
              }
            ]
          }
        ]
      },
      {
        "id": "ms.aad.5",
        "title": "Application Registration and Consent",
        "controls": [
          {
            "id": "ms.aad.5.2v1",
            "title": "Restrict user consent to applications",
            "props": [
              {
                "name": "obligation",
                "ns": "https://scuba.example/ns",
                "value": "SHALL"
              },
              {
                "name": "label",
                "value": "MS.AAD.5.2v1"
              }
            ],
            "links": [
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ac-6.10",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 AC-6(10)"
              },
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#cm-5",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 CM-5"
              }
            ],
            "parts": [
              {
                "id": "ms.aad.5.2v1_smt",
                "name": "statement",
                "prose": "User consent to applications SHALL be restricted."
              },
              {
                "id": "ms.aad.5.2v1_gdn",
                "name": "guidance",
                "prose": "Restricting user consent for applications reduces risk of users giving insecure applications access to their data via [consent grant attacks](https://learn.microsoft.com/en-us/microsoft-365/security/office-365-security/detect-and-remediate-illicit-consent-grants?view=o365-worldwide)."
              }
            ]
          }
        ]
      },
      {
        "id": "ms.aad.7",
        "title": "Highly Privileged User Access",
        "controls": [
          {
            "id": "ms.aad.7.1v1",
            "title": "Limit Global Administrators to 2-8 users",
            "props": [
              {
                "name": "obligation",
                "ns": "https://scuba.example/ns",
                "value": "SHALL"
              },
              {
                "name": "label",
                "value": "MS.AAD.7.1v1"
              }
            ],
            "links": [
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ac-6.5",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 AC-6(5)"
              }
            ],
            "parts": [
              {
                "id": "ms.aad.7.1v1_smt",
                "name": "statement",
                "prose": "A minimum of two users and a maximum of eight users SHALL be provisioned with the Global Administrator role."
              },
              {
                "id": "ms.aad.7.1v1_gdn",
                "name": "guidance",
                "prose": "The Global Administrator role provides unfettered access to the tenant. Limiting the number of users with this level of access makes tenant compromise more challenging. Microsoft recommends fewer than five users in the Global Administrator role. However, additional user accounts, up to eight, may be necessary to support emergency access and some operational scenarios."
              }
            ]
          },
          {
            "id": "ms.aad.7.4v1",
            "title": "No permanent active privileged role assignments",
            "props": [
              {
                "name": "obligation",
                "ns": "https://scuba.example/ns",
                "value": "SHALL NOT"
              },
              {
                "name": "label",
                "value": "MS.AAD.7.4v1"
              }
            ],
            "links": [
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ac-2",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 AC-2"
              }
            ],
            "parts": [
              {
                "id": "ms.aad.7.4v1_smt",
                "name": "statement",
                "prose": "Permanent active role assignments SHALL NOT be allowed for highly privileged roles."
              },
              {
                "id": "ms.aad.7.4v1_gdn",
                "name": "guidance",
                "prose": "Instead of giving users permanent assignments to privileged roles, provisioning access just in time lessens exposure if those accounts become compromised. In Microsoft Entra ID PIM or an alternative PAM system, just in time access can be provisioned by assigning users to roles as eligible instead of perpetually active."
              }
            ]
          }
        ]
      },
      {
        "id": "ms.aad.8",
        "title": "Guest User Access",
        "controls": [
          {
            "id": "ms.aad.8.1v1",
            "title": "Limit guest access to directory objects",
            "props": [
              {
                "name": "obligation",
                "ns": "https://scuba.example/ns",
                "value": "SHOULD"
              },
              {
                "name": "label",
                "value": "MS.AAD.8.1v1"
              }
            ],
            "links": [
              {
                "href": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json#ac-6",
                "rel": "related",
                "text": "NIST SP 800-53 Rev 5 AC-6"
              }
            ],
            "parts": [
              {
                "id": "ms.aad.8.1v1_smt",
                "name": "statement",
                "prose": "Guest users SHOULD have limited or restricted access to Microsoft Entra ID directory objects."
              },
              {
                "id": "ms.aad.8.1v1_gdn",
                "name": "guidance",
                "prose": "Limiting the amount of object information available to guest users in the tenant, reduces malicious reconnaissance exposure if a guest account is compromised or created by an adversary."
              }
            ]
          }
        ]
      }
    ]
  }
}